<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        styleClass="dashboard-root"
        stylesheets="@../css/style.css"
        xmlns="http://javafx.com/javafx/13"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.project.interactivealgorithmvisualizer.controller.DashboardController">

    <!-- Navigation Bar -->
    <top>
        <fx:include source="NavigationBar.fxml"/>
    </top>

    <!-- Main Content -->
    <center>

        <VBox
                alignment="CENTER"
                maxWidth="450.0"
                prefHeight="677.0"
                prefWidth="337.0"
                spacing="15.0">

            <padding>
                <Insets
                        top="15.0"
                        right="20.0"
                        bottom="25.0"
                        left="20.0"/>
            </padding>

            <children>

                <!-- Title -->
                <Label
                        styleClass="dashboard-title"
                        text="Algorithm Visualizer">

                    <font>
                        <Font size="28.0"/>
                    </font>

                </Label>

                <!-- Welcome -->
                <Label
                        styleClass="dashboard-welcome"
                        text="Welcome to Algorithm Learning">

                    <font>
                        <Font size="18.0"/>
                    </font>

                </Label>

                <!-- Dashboard Buttons -->
                <VBox
                        alignment="CENTER"
                        spacing="12.0">

                    <children>

                        <Button
                                mnemonicParsing="false"
                                onAction="#handleSorting"
                                prefWidth="240.0"
                                styleClass="dashboard-button"
                                text="Sorting Algorithms"/>

                        <Button
                                mnemonicParsing="false"
                                onAction="#handleSearching"
                                prefWidth="240.0"
                                styleClass="dashboard-button"
                                text="Searching Algorithms"/>

                        <Button
                                mnemonicParsing="false"
                                onAction="#handleGraph"
                                prefWidth="240.0"
                                styleClass="dashboard-button"
                                text="Graph Algorithms"/>

                        <Button
                                mnemonicParsing="false"
                                onAction="#handleDataStructures"
                                prefWidth="240.0"
                                styleClass="dashboard-button"
                                text="Data Structures"/>

                        <Button
                                mnemonicParsing="false"
                                onAction="#handleHistory"
                                prefWidth="240.0"
                                styleClass="dashboard-button"
                                text="History"/>

                        <Button
                                mnemonicParsing="false"
                                onAction="#handleQuiz"
                                prefWidth="240.0"
                                styleClass="dashboard-button"
                                text="Quiz"/>

                        <Button
                                mnemonicParsing="false"
                                onAction="#handleProgress"
                                prefWidth="240.0"
                                styleClass="dashboard-button"
                                text="Progress"/>

                        <Button
                                mnemonicParsing="false"
                                onAction="#handleExit"
                                prefWidth="240.0"
                                styleClass="exit-button"
                                text="Exit"/>

                    </children>

                    <VBox.margin>
                        <Insets top="10.0"/>
                    </VBox.margin>

                </VBox>

            </children>

        </VBox>

    </center>

</BorderPane>