<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.project.interactivealgorithmvisualizer.controller.LoginController">

    <children>

        <VBox alignment="CENTER"
              maxWidth="600.0"
              spacing="10.0">

            <padding>
                <Insets bottom="25.0"
                        left="25.0"
                        right="25.0"
                        top="25.0"/>
            </padding>

            <children>

                <Label alignment="CENTER"
                       prefHeight="32.0"
                       styleClass="title-label"
                       text="Algorithm Learning &amp; Visualization">

                    <font>
                        <Font size="18.0"/>
                    </font>

                </Label>

                <Label alignment="CENTER"
                       styleClass="welcome-label"
                       text="Welcome Back">

                    <font>
                        <Font size="18.0"/>
                    </font>

                </Label>

                <Label alignment="CENTER"
                       styleClass="subtitle-label"
                       text="Learn • Visualize • Practice">

                    <font>
                        <Font size="13.0"/>
                    </font>

                </Label>

                <VBox alignment="CENTER_LEFT"
                      maxWidth="350.0"
                      spacing="5.0">

                    <children>

                        <Label text="Email / Gmail"/>

                        <TextField fx:id="usernameField"
                                   prefHeight="35.0"
                                   prefWidth="350.0"
                                   promptText="Enter your email"
                                   styleClass="text-field"/>

                        <Label text="Password">
                            <VBox.margin>
                                <Insets top="5.0"/>
                            </VBox.margin>
                        </Label>

                        <PasswordField fx:id="passwordField"
                                       prefHeight="35.0"
                                       prefWidth="350.0"
                                       promptText="Enter password"
                                       styleClass="password-field"/>

                        <CheckBox mnemonicParsing="false"
                                  text="Remember Me">

                            <VBox.margin>
                                <Insets bottom="5.0"
                                        top="5.0"/>
                            </VBox.margin>

                        </CheckBox>

                    </children>

                    <VBox.margin>
                        <Insets top="10.0"/>
                    </VBox.margin>

                </VBox>

                <Button mnemonicParsing="false"
                        onAction="#handleLogin"
                        prefHeight="40.0"
                        prefWidth="350.0"
                        styleClass="login-button"
                        text="LOGIN"/>
                
                <Label fx:id="statusLabel"
                alignment="CENTER"
                maxWidth="350.0"
                text=""
                wrapText="true"/>

                <Hyperlink text="Forgot Password?"/>

                <Label text="─── OR ───"/>

                <Button mnemonicParsing="false"
                        onAction="#handleGuestLogin"
                        prefHeight="40.0"
                        prefWidth="350.0"
                        styleClass="guest-button"
                        text="Continue as Guest"/>

                <Hyperlink mnemonicParsing="false"
                           onAction="#handleRegister"
                           text="Don't have an account? Register"/>

            </children>

        </VBox>

    </children>

</StackPane>
