<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/13"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.interactivealgorithmvisualizer.controller.NavigationController"
      spacing="10"
      alignment="CENTER_LEFT"
      prefHeight="50.0"
      minHeight="50.0"
      maxHeight="50.0">

    <padding>
        <Insets top="8" right="10" bottom="8" left="10"/>
    </padding>

    <Button fx:id="backButton"
            text="← Back"
            prefWidth="90"
            prefHeight="34"
            onAction="#handleBack"/>

    <Button fx:id="refreshButton"
            text="⟳ Refresh"
            prefWidth="100"
            prefHeight="34"
            onAction="#handleRefresh"/>

    <Button fx:id="homeButton"
            text="⌂ Home"
            prefWidth="90"
            prefHeight="34"
            onAction="#handleHome"/>

</HBox>