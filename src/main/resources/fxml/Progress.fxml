<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.project.interactivealgorithmvisualizer.controller.ProgressController">

    <top>
        <VBox spacing="8"
              alignment="CENTER"
              style="-fx-padding: 20;">

            <Label text="Progress"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

            <Label text="Your quiz performance"
                   style="-fx-font-size: 14px;"/>

        </VBox>
    </top>

    <center>
        <VBox spacing="15"
              style="-fx-padding: 20;">

            <!-- Statistics -->

            <HBox spacing="30"
                  alignment="CENTER">

                <VBox alignment="CENTER"
                      spacing="5">

                    <Label text="Total Quizzes"
                           style="-fx-font-size: 16px;"/>

                    <Label fx:id="totalQuizzesLabel"
                           text="0"
                           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox alignment="CENTER"
                      spacing="5">

                    <Label text="Best Score"
                           style="-fx-font-size: 16px;"/>

                    <Label fx:id="bestScoreLabel"
                           text="0"
                           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox alignment="CENTER"
                      spacing="5">

                    <Label text="Average Score"
                           style="-fx-font-size: 16px;"/>

                    <Label fx:id="averageScoreLabel"
                           text="0%"
                           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                </VBox>

            </HBox>


            <!-- Quiz History -->

            <Label text="Quiz History"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <TableView fx:id="quizHistoryTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="scoreColumn"
                                 text="Score"
                                 prefWidth="150"/>

                    <TableColumn fx:id="totalQuestionsColumn"
                                 text="Total Questions"
                                 prefWidth="180"/>

                    <TableColumn fx:id="dateColumn"
                                 text="Created At"
                                 prefWidth="200"/>

                </columns>

            </TableView>

        </VBox>
    </center>


    <bottom>
        <HBox alignment="CENTER"
              spacing="15"
              style="-fx-padding: 15;">

            <Button fx:id="refreshButton"
                    text="Refresh"
                    onAction="#handleRefresh"/>

            <Button fx:id="backButton"
                    text="Back"
                    onAction="#handleBack"/>

        </HBox>
    </bottom>

</BorderPane>