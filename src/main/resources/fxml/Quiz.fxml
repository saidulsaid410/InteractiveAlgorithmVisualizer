<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/13"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.interactivealgorithmvisualizer.controller.QuizController"
      spacing="15"
      alignment="TOP_CENTER">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label fx:id="titleLabel"
           text="Algorithm Quiz"/>

    <Label fx:id="questionNumberLabel"
           text="Question 1"/>

    <Separator/>

    <Label fx:id="questionLabel"
           text="Question will appear here."
           wrapText="true"/>

    <RadioButton fx:id="optionA"
                 text="Option A">
        <toggleGroup>
            <ToggleGroup fx:id="answerGroup"/>
        </toggleGroup>
    </RadioButton>

    <RadioButton fx:id="optionB"
                 text="Option B"
                 toggleGroup="$answerGroup"/>

    <RadioButton fx:id="optionC"
                 text="Option C"
                 toggleGroup="$answerGroup"/>

    <RadioButton fx:id="optionD"
                 text="Option D"
                 toggleGroup="$answerGroup"/>

    <Button fx:id="nextButton"
            text="Next"
            onAction="#handleNext"/>

    <Label fx:id="resultLabel"
           text=""/>

    <Button fx:id="backButton"
            text="Back"
            onAction="#handleBack"/>

</VBox>