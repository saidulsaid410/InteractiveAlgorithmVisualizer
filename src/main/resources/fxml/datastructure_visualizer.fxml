<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="950.0"
            stylesheets="@css/style.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.project.interactivealgorithmvisualizer.controller.DataStructureVisualizerController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets bottom="10" left="20" right="20" top="15" />
            </padding>

            <Button fx:id="backButton"
                    onAction="#handleBack"
                    styleClass="back-button"
                    text="← Back" />

            <Label fx:id="titleLabel"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"
                   text="Data Structure Visualization" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15">
            <padding>
                <Insets bottom="15" left="20" right="20" top="10" />
            </padding>

            <!-- Value Input -->
            <HBox alignment="CENTER" spacing="15">

                <Label text="Value:" />

                <TextField fx:id="valueInput"
                           prefWidth="130"
                           promptText="Enter value" />

                <!-- Insert First / Push / Enqueue -->
                <Button fx:id="actionButton1"
                        onAction="#handlePrimaryAction"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white;"
                        text="Push" />

                <!-- Insert Last / Pop / Dequeue -->
                <Button fx:id="actionButton2"
                        onAction="#handleSecondaryAction"
                        style="-fx-background-color: #c62828; -fx-text-fill: white;"
                        text="Pop" />

                <!-- Delete First / Peek / Front -->
                <Button fx:id="btnTertiary"
                        onAction="#handleTertiaryAction"
                        text="Peek" />

                <!-- Delete Last -->
                <Button fx:id="btnDeleteLast"
                        onAction="#handleDeleteLast"
                        text="Delete Last" />

                <!-- Clear -->
                <Button fx:id="btnClear"
                        onAction="#handleClear"
                        text="Clear" />

            </HBox>

            <!-- Visualization -->
            <Pane fx:id="visualizationPane"
                  prefHeight="380.0"
                  prefWidth="900.0"
                  style="-fx-border-color: #ccc; -fx-background-color: #ffffff; -fx-border-radius: 5;" />

            <Label fx:id="statusLabel"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;"
                   text="Ready." />

        </VBox>
    </center>

</BorderPane>