<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- 🌟 এখানে fx:controller যুক্ত করা হয়েছে -->
<StackPane prefHeight="600.0" prefWidth="900.0" stylesheets="@css/style.css" 
           xmlns="http://javafx.com/javafx/26" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.project.interactivealgorithmvisualizer.controller.DatastructureControler">

    <children>
        <VBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

            <!-- Title -->
            <Label styleClass="data-title" text="DATA STRUCTURES ">
                <font>
                    <Font size="30.0" />
                </font>
            </Label>

            <!-- Subtitle -->
            <Label styleClass="data-subtitle" text="Explore • Visualize • Understand">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>

            <!-- First Row -->
            <HBox alignment="CENTER" spacing="25.0">
                <!-- Stack -->
                <Button fx:id="stackButton" mnemonicParsing="false" onAction="#handleStack" prefHeight="130.0" prefWidth="250.0" styleClass="data-structure-button" text="📚 STACK">
                    <font>
                        <Font size="22.0" />
                    </font>
                </Button>

                <!-- Queue -->
                <Button fx:id="queueButton" mnemonicParsing="false" onAction="#handleQueue" prefHeight="130.0" prefWidth="250.0" styleClass="data-structure-button" text="🔄 QUEUE">
                    <font>
                        <Font size="22.0" />
                    </font>
                </Button>
            </HBox>

            <!-- Second Row -->
            <HBox alignment="CENTER" spacing="25.0">
                <!-- Linked List -->
                <Button fx:id="linkedListButton" mnemonicParsing="false" onAction="#handleLinkedList" prefHeight="130.0" prefWidth="250.0" styleClass="data-structure-button" text="🔗 LINKED LIST">
                    <font>
                        <Font size="22.0" />
                    </font>
                </Button>

                <!-- BST -->
                <Button fx:id="bstButton" mnemonicParsing="false" onAction="#handleBST" prefHeight="130.0" prefWidth="250.0" styleClass="data-structure-button" text="🌳 BST">
                    <font>
                        <Font size="22.0" />
                    </font>
                </Button>
            </HBox>

            <!-- Back Button -->
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" prefHeight="45.0" prefWidth="150.0" styleClass="back-button" text="← Back">
                <font>
                    <Font size="16.0" />
                </font>
            </Button>
        </VBox>
    </children>
</StackPane>