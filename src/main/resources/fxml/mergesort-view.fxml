<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.project.interactivealgorithmvisualizer.controller.MergeSortController">

    <!-- TOP HEADER -->
    <top>
        <VBox spacing="8.0">
            <padding>
                <Insets top="20.0" right="25.0" bottom="15.0" left="25.0"/>
            </padding>

            <Label text="MERGE SORT VISUALIZATION">
                <font>
                    <Font size="26.0"/>
                </font>
            </Label>

            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Label text="Array Elements (Comma Separated):"/>
                
                <TextField fx:id="arrayInputField"
                           prefWidth="300.0"
                           promptText="40, 10, 20, 50, 30, 80, 60"/>

                <Button fx:id="generateButton"
                        mnemonicParsing="false"
                        onAction="#handleGenerate"
                        text="GENERATE"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER (VISUALIZATION CANVAS) -->
    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets top="10.0" right="25.0" bottom="10.0" left="25.0"/>
            </padding>

            <Label text="Visualization Area">
                <font>
                    <Font size="20.0"/>
                </font>
            </Label>

            <!-- Array Bars Container -->
            <Pane fx:id="visualizationPane"
                  prefHeight="430.0"
                  prefWidth="750.0"
                  style="-fx-background-color: #f8f9fa; -fx-border-color: #cccccc; -fx-border-width: 1;"/>
        </VBox>
    </center>

    <!-- RIGHT PANEL (DETAILS & STATUS) -->
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" prefWidth="300.0" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="10.0" prefWidth="280.0">
                    <padding>
                        <Insets top="10.0" right="20.0" bottom="20.0" left="15.0"/>
                    </padding>

                    <Label text="Algorithm Status">
                        <font>
                            <Font size="20.0"/>
                        </font>
                    </Label>

                    <Label text="Status Message"/>
                    <Label fx:id="statusLabel"
                           text="Ready to sort."
                           wrapText="true"/>

                    <Label text="Current Step Info"/>
                    <TextArea fx:id="stepLogArea"
                              editable="false"
                              prefHeight="120.0"
                              wrapText="true"/>

                    <Label text="Time Complexity"/>
                    <Label fx:id="timeComplexityLabel"
                           text="O(n log n)"/>

                    <Label text="Space Complexity"/>
                    <Label fx:id="spaceComplexityLabel"
                           text="O(n)"/>
                </VBox>
            </content>
        </ScrollPane>
    </right>

    <!-- BOTTOM CONTROLS -->
    <bottom>
        <HBox alignment="CENTER" spacing="15.0">
            <padding>
                <Insets top="15.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <Button fx:id="startButton"
                    mnemonicParsing="false"
                    onAction="#handleStart"
                    prefWidth="100.0"
                    text="START"/>

            <Button fx:id="pauseButton"
                    mnemonicParsing="false"
                    onAction="#handlePause"
                    prefWidth="100.0"
                    text="PAUSE"/>

            <Button fx:id="stepButton"
                    mnemonicParsing="false"
                    onAction="#handleStep"
                    prefWidth="100.0"
                    text="STEP"/>

            <Button fx:id="resetButton"
                    mnemonicParsing="false"
                    onAction="#handleReset"
                    prefWidth="100.0"
                    text="RESET"/>

            <Button fx:id="backButton"
                    mnemonicParsing="false"
                    onAction="#handleBack"
                    prefWidth="100.0"
                    text="BACK"/>
        </HBox>
    </bottom>

</BorderPane>