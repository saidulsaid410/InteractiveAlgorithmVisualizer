<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.project.interactivealgorithmvisualizer.controller.SearchController">

   <children>
      <!-- VBox alignment="CENTER" -->
      <VBox alignment="CENTER" spacing="20.0" maxWidth="450.0">
         <padding>
            <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
         </padding>

         <children>
            <!-- Title -->
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Searching Algorithm">
               <font>
                  <Font size="36.0" />
               </font>
            </Text>

            <!-- Linear Search Button -->
            <Button fx:id="linearSearchButton" mnemonicParsing="false" onAction="#handleLinearSearch" text="Linear Search" textFill="#0fa2bd">
               <font>
                  <Font size="28.0" />
               </font>
            </Button>

            <!-- Binary Search Button -->
            <Button fx:id="binarySearchButton" mnemonicParsing="false" onAction="#handleBinarySearch" text="Binary Search" textFill="#21a9cf">
               <font>
                  <Font size="28.0" />
               </font>
            </Button>

            <!-- Back Button -->
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" text="Back" textFill="#232222">
               <font>
                  <Font size="24.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>